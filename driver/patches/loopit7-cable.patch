new file mode 100644
index 0000000000000000000000000000000000000000..2b4f7147bf50c4512c01729b93be768e953e5c82
--- /dev/null
+++ b/audio/sysvad/EndpointsCommon/CableRing.h
@@ -0,0 +1,99 @@
+/*++
+
+Module Name:
+
+    CableRing.h
+
+Abstract:
+
+    LoopIt7 Cable, not part of Microsoft's sample. The buffer that turns the driver's one
+    playback endpoint and one recording endpoint into a cable: whatever a program plays into
+    "Cable In" comes out of "Cable Out".
+
+    One writer, any number of readers. Only one render stream can exist (the cable's render
+    filter allows a single pin instance and a single processing mode, see
+    TabletAudioSample\cablespeakerwavtable.h), and the ring enforces that as well: the first
+    stream to write owns it until it leaves RUN. Readers each keep their own cursor in a
+    CABLE_READER, so two programs recording the cable (Windows can open one capture stream
+    per processing mode) both hear everything instead of splitting the audio between them.
+
+    Both sides are clocked by their own stream timer, the same way every stream in this
+    driver is. A reader sits a fixed pre-roll behind the writer to absorb timer jitter;
+    if it drifts too far either way it resyncs rather than growing latency or handing out
+    stale audio, and it never locks on to data written before the current writer started.
+
+    All positions are absolute byte counts. The ring keeps ring position congruent to the
+    writer's own linear position modulo the block alignment, and readers resync so their
+    position is congruent to their own, which keeps sample frames lined up across the two
+    independent streams.
+
+    Every method may be called at IRQL <= DISPATCH_LEVEL and lives in non-paged code
+    (CableRing.cpp).
+
+--*/
+
+#ifndef _LOOPIT7_CABLERING_H_
+#define _LOOPIT7_CABLERING_H_
+
+typedef struct _CABLE_READER
+{
+    ULONGLONG   Position;   // absolute ring position of the next byte this reader delivers
+    ULONG       Cushion;    // how far behind the writer this reader aims to sit, in bytes
+    BOOLEAN     Synced;     // locked on to the current writer
+    BOOLEAN     Refilling;  // underran; delivering silence until the cushion is back
+} CABLE_READER, *PCABLE_READER;
+
+class CCableRing
+{
+public:
+    CCableRing();
+    ~CCableRing();
+
+    _IRQL_requires_(PASSIVE_LEVEL)
+    NTSTATUS Allocate(_In_ ULONG BytesPerSecond, _In_ ULONG BlockAlign);
+
+    _IRQL_requires_max_(DISPATCH_LEVEL)
+    VOID Free();
+
+    _IRQL_requires_max_(DISPATCH_LEVEL)
+    VOID Write
+    (
+        _In_                    PVOID       Writer,
+        _In_reads_bytes_(Bytes) const BYTE* Source,
+        _In_                    ULONG       Bytes,
+        _In_                    ULONGLONG   SourceLinearPosition
+    );
+
+    _IRQL_requires_max_(DISPATCH_LEVEL)
+    VOID ReleaseWriter(_In_ PVOID Writer);
+
+    _IRQL_requires_max_(DISPATCH_LEVEL)
+    static VOID ResetReader(_Out_ PCABLE_READER Reader);
+
+    _IRQL_requires_max_(DISPATCH_LEVEL)
+    VOID Read
+    (
+        _Inout_                     PCABLE_READER   Reader,
+        _Out_writes_bytes_(Bytes)   BYTE*           Destination,
+        _In_                        ULONG           Bytes,
+        _In_                        ULONGLONG       DestinationLinearPosition
+    );
+
+private:
+    KSPIN_LOCK  m_Lock;
+    BYTE*       m_pBuffer;
+    ULONG       m_ulCapacity;
+    ULONG       m_ulBlockAlign;
+    ULONG       m_ulPrerollBytes;
+    ULONG       m_ulMaxLagBytes;
+    ULONG       m_ulMaxWriteChunk;
+    ULONGLONG   m_ullWritePosition;
+    ULONGLONG   m_ullWriterStart;
+    PVOID       m_pActiveWriter;
+
+    ULONG CushionFor(_In_ ULONG ReadBytes) const;
+};
+
+typedef CCableRing *PCCableRing;
+
+#endif // _LOOPIT7_CABLERING_H_
