+//=============================================================================
+#pragma code_seg()
+VOID CMiniportWaveRTStream::PushToCable
+(
+    _In_ ULONG ByteDisplacement
+)
+/*++
+
+Routine Description:
+
+LoopIt7 Cable: copies the region of the render buffer that has just been played into the
+cable's ring. Only the cable's system render stream does this.
+
+Arguments:
+
+ByteDisplacement - # of bytes to process.
