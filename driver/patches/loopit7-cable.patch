index 0000000000000000000000000000000000000000..53ae44d281814e7541e20b429cf582273e31f6f4
--- /dev/null
+++ b/audio/sysvad/EndpointsCommon/CableRing.cpp
@@ -0,0 +1,363 @@
+/*++
+
+Module Name:
+
+    CableRing.cpp
+
+Abstract:
+
+    LoopIt7 Cable, not part of Microsoft's sample. Implementation of CCableRing; see
+    CableRing.h for what it is for.
+
+    Everything here runs at up to DISPATCH_LEVEL from the stream timers, so the whole file is
+    non-paged and takes a spin lock, never anything that can block or fault.
+
+--*/
+
+#include <sysvad.h>
+#include "CableRing.h"
+
+#define CABLERING_POOLTAG       'gRCL'
+
+#define CABLERING_CAPACITY_MS   500     // how much audio the ring can hold at all
+#define CABLERING_PREROLL_MS    30      // minimum distance a reader keeps behind the writer
+#define CABLERING_MAX_LAG_MS    90      // extra lag tolerated beyond the cushion before resync
+
+#pragma code_seg()
+
+static ULONG AlignDown(_In_ ULONG Value, _In_ ULONG Alignment)
+{
+    return Value - (Value % Alignment);
+}
+
+static ULONG AlignUp(_In_ ULONG Value, _In_ ULONG Alignment)
+{
+    ULONG remainder = Value % Alignment;
+    return remainder == 0 ? Value : Value + (Alignment - remainder);
+}
+
+CCableRing::CCableRing() :
+    m_pBuffer(NULL),
+    m_ulCapacity(0),
+    m_ulBlockAlign(1),
+    m_ulPrerollBytes(0),
+    m_ulMaxLagBytes(0),
+    m_ulMaxWriteChunk(0),
+    m_ullWritePosition(0),
+    m_ullWriterStart(0),
+    m_pActiveWriter(NULL)
+{
+    KeInitializeSpinLock(&m_Lock);
+}
+
+CCableRing::~CCableRing()
+{
+    Free();
+}
+
+_Use_decl_annotations_
+NTSTATUS CCableRing::Allocate(ULONG BytesPerSecond, ULONG BlockAlign)
+{
+    if (BlockAlign == 0 || BytesPerSecond < BlockAlign)
+    {
+        return STATUS_INVALID_PARAMETER;
+    }
+
+    ULONG capacity = AlignDown((ULONG)(((ULONGLONG)BytesPerSecond * CABLERING_CAPACITY_MS) / 1000), BlockAlign);
+    ULONG preroll  = AlignDown((ULONG)(((ULONGLONG)BytesPerSecond * CABLERING_PREROLL_MS)  / 1000), BlockAlign);
+    ULONG maxLag   = AlignDown((ULONG)(((ULONGLONG)BytesPerSecond * CABLERING_MAX_LAG_MS)  / 1000), BlockAlign);
+
+    if (preroll < BlockAlign || maxLag < BlockAlign || capacity <= preroll + maxLag)
+    {
+        return STATUS_INVALID_PARAMETER;
+    }
+
+    // Zero-initialised by ExAllocatePool2, so an early reader hears silence, not garbage.
+    BYTE* buffer = (BYTE*)ExAllocatePool2(POOL_FLAG_NON_PAGED, capacity, CABLERING_POOLTAG);
+    if (buffer == NULL)
+    {
+        return STATUS_INSUFFICIENT_RESOURCES;
+    }
+
+    Free();
+
+    KIRQL oldIrql;
+    KeAcquireSpinLock(&m_Lock, &oldIrql);
+
+    m_pBuffer          = buffer;
+    m_ulCapacity       = capacity;
+    m_ulBlockAlign     = BlockAlign;
+    m_ulPrerollBytes   = preroll;
+    m_ulMaxLagBytes    = maxLag;
+    m_ulMaxWriteChunk  = 0;
+    m_ullWritePosition = 0;
+    m_ullWriterStart   = 0;
+    m_pActiveWriter    = NULL;
+
+    KeReleaseSpinLock(&m_Lock, oldIrql);
+
+    return STATUS_SUCCESS;
+}
+
+_Use_decl_annotations_
+VOID CCableRing::Free()
+{
+    BYTE* buffer;
+
+    KIRQL oldIrql;
+    KeAcquireSpinLock(&m_Lock, &oldIrql);
+
+    buffer          = m_pBuffer;
+    m_pBuffer       = NULL;
+    m_ulCapacity    = 0;
+    m_pActiveWriter = NULL;
+
+    KeReleaseSpinLock(&m_Lock, oldIrql);
+
+    if (buffer != NULL)
+    {
+        ExFreePoolWithTag(buffer, CABLERING_POOLTAG);
+    }
+}
+
+_Use_decl_annotations_
+VOID CCableRing::Write(PVOID Writer, const BYTE* Source, ULONG Bytes, ULONGLONG SourceLinearPosition)
+{
+    if (Writer == NULL || Source == NULL || Bytes == 0)
+    {
+        return;
+    }
+
+    KIRQL oldIrql;
+    KeAcquireSpinLock(&m_Lock, &oldIrql);
+
+    if (m_pBuffer == NULL || m_ulCapacity == 0)
+    {
+        goto Done;
+    }
+
+    if (m_pActiveWriter == NULL)
+    {
+        // A new writer. Start it on a fresh frame boundary, offset so ring position stays
+        // congruent to its linear position; readers rely on that to keep frames aligned.
+        ULONGLONG base = m_ullWritePosition + (m_ulBlockAlign - 1);
+        base -= base % m_ulBlockAlign;
+
+        ULONGLONG start = base + (SourceLinearPosition % m_ulBlockAlign);
+
+        // The few bytes skipped to reach that boundary still hold whatever an earlier writer
+        // left there. Silence them, in case a reader is still draining up to this point.
+        for (ULONGLONG gap = m_ullWritePosition; gap < start; gap++)
+        {
+            m_pBuffer[gap % m_ulCapacity] = 0;
+        }
+
+        m_ullWritePosition = start;
+        m_ullWriterStart   = m_ullWritePosition;
+        m_ulMaxWriteChunk  = 0;
+        m_pActiveWriter    = Writer;
+    }
+    else if (m_pActiveWriter != Writer)
+    {
+        // Somebody else owns the cable. Dropping this is correct: the render filter only
+        // allows one stream, so this is a transition edge, not a second program's audio.
+        goto Done;
+    }
+
+    if (Bytes > m_ulCapacity)
+    {
+        // More than the ring holds arrived at once (a long stall). Keep only the newest.
+        ULONG skip = Bytes - m_ulCapacity;
+        Source             += skip;
+        m_ullWritePosition += skip;
+        Bytes               = m_ulCapacity;
+    }
+
+    if (Bytes > m_ulMaxWriteChunk)
+    {
+        m_ulMaxWriteChunk = min(Bytes, m_ulCapacity / 4);
+    }
+
+    {
+        ULONG offset = (ULONG)(m_ullWritePosition % m_ulCapacity);
+        ULONG first  = min(Bytes, m_ulCapacity - offset);
+
+        RtlCopyMemory(m_pBuffer + offset, Source, first);
+        if (Bytes > first)
+        {
+            RtlCopyMemory(m_pBuffer, Source + first, Bytes - first);
+        }
+
+        m_ullWritePosition += Bytes;
+    }
+
+Done:
+    KeReleaseSpinLock(&m_Lock, oldIrql);
+}
+
+_Use_decl_annotations_
+VOID CCableRing::ReleaseWriter(PVOID Writer)
+{
+    KIRQL oldIrql;
+    KeAcquireSpinLock(&m_Lock, &oldIrql);
+
+    if (m_pActiveWriter == Writer)
+    {
+        m_pActiveWriter = NULL;
+    }
+
+    KeReleaseSpinLock(&m_Lock, oldIrql);
+}
+
+_Use_decl_annotations_
+VOID CCableRing::ResetReader(PCABLE_READER Reader)
+{
+    Reader->Position  = 0;
+    Reader->Cushion   = 0;
+    Reader->Synced    = FALSE;
+    Reader->Refilling = FALSE;
+}
+
+// How far behind the writer a reader should sit: the pre-roll, but at least two of either
+// side's chunks, so a reader pulling 50 ms at a time off a writer pushing 10 ms at a time
+// does not run dry between them. Capped so it always leaves room for the lag allowance.
+// Caller holds m_Lock.
+_Use_decl_annotations_
+ULONG CCableRing::CushionFor(ULONG ReadBytes) const
+{
+    ULONG cushion = m_ulPrerollBytes;
+
+    if (ReadBytes <= m_ulCapacity / 4 && ReadBytes * 2 > cushion)
+    {
+        cushion = ReadBytes * 2;
+    }
+    if (m_ulMaxWriteChunk * 2 > cushion)
+    {
+        cushion = m_ulMaxWriteChunk * 2;
+    }
+
+    cushion = AlignUp(cushion, m_ulBlockAlign);
+
+    ULONG ceiling = AlignDown(m_ulCapacity - m_ulMaxLagBytes, m_ulBlockAlign);
+    return min(cushion, ceiling);
+}
+
+_Use_decl_annotations_
+VOID CCableRing::Read(PCABLE_READER Reader, BYTE* Destination, ULONG Bytes, ULONGLONG DestinationLinearPosition)
+{
+    if (Destination == NULL || Bytes == 0)
+    {
+        return;
+    }
+
+    ULONG delivered = 0;
+
+    if (Reader != NULL)
+    {
+        KIRQL oldIrql;
+        KeAcquireSpinLock(&m_Lock, &oldIrql);
+
+        if (m_pBuffer != NULL && m_ulCapacity != 0)
+        {
+            ULONGLONG writePosition = m_ullWritePosition;
+
+            if (Reader->Synced)
+            {
+                ULONGLONG position = Reader->Position;
+
+                if (position > writePosition ||
+                    writePosition - position > m_ulCapacity ||
+                    writePosition - position > (ULONGLONG)Reader->Cushion + m_ulMaxLagBytes)
+                {
+                    // Drifted too far behind, or the data it wanted has been overwritten.
+                    // Jumping ahead to a fresh lock never replays anything it already heard.
+                    Reader->Synced = FALSE;
+                }
+                else if (Reader->Refilling)
+                {
+                    if (position < m_ullWriterStart)
+                    {
+                        // A new writer started while we waited; lock on to it afresh
+                        // rather than play the old writer's leftover tail.
+                        Reader->Synced = FALSE;
+                    }
+                    else
+                    {
+                        ULONG cushion = CushionFor(Bytes);
+                        if (cushion > Reader->Cushion)
+                        {
+                            Reader->Cushion = cushion;
+                        }
+                        if (writePosition - position >= Reader->Cushion)
+                        {
+                            // The underrun delivered a partial chunk, so this reader's position
+                            // may no longer sit on the same sample boundary as its destination.
+                            // Skip the remainder of a frame (always less than one) to restore it.
+                            ULONG realign = (ULONG)(((DestinationLinearPosition % m_ulBlockAlign) +
+                                                     m_ulBlockAlign - (position % m_ulBlockAlign)) %
+                                                    m_ulBlockAlign);
+
+                            Reader->Position  = position + realign;
+                            Reader->Refilling = FALSE;
+                        }
+                    }
+                }
+            }
+
+            if (!Reader->Synced && m_pActiveWriter != NULL)
+            {
+                ULONG cushion = CushionFor(Bytes);
+
+                // Only lock on once the current writer has produced a full cushion, so the
+                // reader never reaches back into audio from before this writer started.
+                if (writePosition >= m_ullWriterStart &&
+                    writePosition - m_ullWriterStart >= (ULONGLONG)cushion + m_ulBlockAlign)
+                {
+                    ULONGLONG target = writePosition - cushion;
+                    target -= target % m_ulBlockAlign;
+                    target += DestinationLinearPosition % m_ulBlockAlign;
+
+                    Reader->Position  = target;
+                    Reader->Cushion   = cushion;
+                    Reader->Synced    = TRUE;
+                    Reader->Refilling = FALSE;
+                }
+            }
+
+            if (Reader->Synced && !Reader->Refilling)
+            {
+                ULONGLONG available = writePosition - Reader->Position;
+                ULONG     take      = (available >= Bytes) ? Bytes : (ULONG)available;
+
+                if (take > 0)
+                {
+                    ULONG offset = (ULONG)(Reader->Position % m_ulCapacity);
+                    ULONG first  = min(take, m_ulCapacity - offset);
+
+                    RtlCopyMemory(Destination, m_pBuffer + offset, first);
+                    if (take > first)
+                    {
+                        RtlCopyMemory(Destination + first, m_pBuffer, take - first);
+                    }
+
+                    Reader->Position += take;
+                    delivered = take;
+                }
+
+                if (take < Bytes)
+                {
+                    // Ran dry. Pad with silence and wait for the cushion to rebuild, instead of
+                    // resyncing backwards and replaying audio this reader already delivered.
+                    Reader->Refilling = TRUE;
+                }
+            }
+        }
+
+        KeReleaseSpinLock(&m_Lock, oldIrql);
+    }
+
+    if (delivered < Bytes)
+    {
+        RtlZeroMemory(Destination + delivered, Bytes - delivered);
+    }
+}
