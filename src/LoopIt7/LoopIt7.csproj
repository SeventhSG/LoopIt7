<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\LoopIt7.ico</ApplicationIcon>
    <AssemblyName>LoopIt7</AssemblyName>
    <RootNamespace>LoopIt7</RootNamespace>
    <Version>1.5.0</Version>
    <FileVersion>1.5.0.0</FileVersion>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <Product>LoopIt7</Product>
    <Company>SeventhSG</Company>
    <Copyright>Copyright (c) 2026 SeventhSG</Copyright>
    <Description>A patchbay for Windows audio. Every source, every output, and the cables in between.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The manifest is the WPF way to declare PerMonitorV2. The WinForms analyser only sees
         the WinForms reference we pull in for the tray icon, so its advice does not apply. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\LoopIt7.ico" />
  </ItemGroup>

</Project>
