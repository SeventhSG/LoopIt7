<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LoopIt7 design tokens.

        Palette: one warm near black family plus a single amber accent. Amber is the studio
        gear colour, it reads as signal, and it keeps the app off the default blue. Red is
        reserved for two semantic states only: clipping and a device that will not open.

        Shape rule, applied everywhere: surfaces 10px, controls 6px, the transport toggle is
        a pill. Nothing else invents a radius.
    -->

    <Color x:Key="BgColor">#100F0D</Color>
    <Color x:Key="SurfaceColor">#191714</Color>
    <Color x:Key="SurfaceHiColor">#221F1A</Color>
    <Color x:Key="SunkenColor">#131110</Color>
    <Color x:Key="LineColor">#2B2723</Color>
    <Color x:Key="LineStrongColor">#3C352E</Color>
    <Color x:Key="TextColor">#EDE9E3</Color>
    <Color x:Key="TextDimColor">#9A9188</Color>
    <Color x:Key="TextFaintColor">#6C655C</Color>
    <Color x:Key="AccentColor">#E8A33D</Color>
    <Color x:Key="AccentPressColor">#C9862A</Color>
    <Color x:Key="AccentSoftColor">#3B2E19</Color>
    <Color x:Key="DangerColor">#E0553F</Color>
    <Color x:Key="DangerSoftColor">#3A1F1A</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceHiBrush" Color="{StaticResource SurfaceHiColor}" />
    <SolidColorBrush x:Key="SunkenBrush" Color="{StaticResource SunkenColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrongColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentPressBrush" Color="{StaticResource AccentPressColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="#00000000" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <CornerRadius x:Key="SurfaceRadius">10</CornerRadius>
    <CornerRadius x:Key="ControlRadius">6</CornerRadius>
    <CornerRadius x:Key="PillRadius">999</CornerRadius>

    <!--
        Motion budget. App.xaml.cs rewrites this to zero when Windows has animation effects
        switched off, which is the platform's reduced motion setting.
    -->
    <Duration x:Key="MotionFast">0:0:0.12</Duration>

    <!--
        The mark: one source node fanning out to three destinations. It is the product
        described in twenty vector points, drawn on a 20 by 20 box.
    -->
    <PathGeometry x:Key="MarkStrokes"
                  Figures="M3.6,10 C8.4,10 8.4,4.4 14.6,4.4 M3.6,10 L14.6,10 M3.6,10 C8.4,10 8.4,15.6 14.6,15.6" />

    <GeometryGroup x:Key="MarkDots">
        <EllipseGeometry Center="3.4,10" RadiusX="2.7" RadiusY="2.7" />
        <EllipseGeometry Center="15.4,4.4" RadiusX="1.9" RadiusY="1.9" />
        <EllipseGeometry Center="15.4,10" RadiusX="1.9" RadiusY="1.9" />
        <EllipseGeometry Center="15.4,15.6" RadiusX="1.9" RadiusY="1.9" />
    </GeometryGroup>

</ResourceDictionary>
