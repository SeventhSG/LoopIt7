<UserControl x:Class="LoopIt7.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LoopIt7.Views">

    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="18,0,18,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Only shown when the machine has no software cable at all. -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Background="{StaticResource SunkenBrush}"
                Padding="16,14" Margin="0,0,0,12"
                Visibility="{Binding HasVirtualCable, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="No software cable is installed" Style="{StaticResource SectionLabel}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"
                               Text="LoopIt7 can send audio to any output on this machine, and it can capture a single program without one. To hand a mix to another program as if it were a microphone, Windows needs a virtual cable, and a virtual cable is a signed kernel driver. VB-Audio's is free and takes a minute to install." />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                        Command="{Binding OpenCableSiteCommand}"
                        Content="Get VB-Cable" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,10,0">
            <ItemsControl ItemsSource="{Binding DeviceRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,4,8" Padding="16,13">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextDimBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                                <Setter Property="Text" Value="&#xE767;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInput}" Value="True">
                                                        <Setter Property="Text" Value="&#xE720;" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsVirtual}" Value="True">
                                                        <Setter Property="Text" Value="&#xE71B;" />
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="{StaticResource PillRadius}"
                                                    Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="default" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                            <Border Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource LineStrongBrush}"
                                                    BorderThickness="1" CornerRadius="{StaticResource PillRadius}"
                                                    Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding VirtualFamily}" FontSize="11"
                                                           Foreground="{StaticResource TextDimBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding DirectionText}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding InterfaceName}" Margin="10,0,0,0"
                                                       MaxWidth="220" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding FormatText}" Margin="10,0,0,0"
                                                       FontFamily="{StaticResource MonoFont}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Height="30" Padding="12,0"
                                                Command="{Binding MakeDefaultCommand}"
                                                Content="Make default" />
                                        <Button Style="{StaticResource GhostButton}" Height="30" Padding="12,0" Margin="6,0,0,0"
                                                Command="{Binding ToggleExpandCommand}"
                                                Content="Format" />
                                    </StackPanel>
                                </Grid>

                                <Border Margin="0,13,0,0" Padding="14,12"
                                        Background="{StaticResource SunkenBrush}"
                                        CornerRadius="{StaticResource ControlRadius}"
                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Text="This is the format the Windows audio engine runs the device at. Programs already playing keep the old one until they reopen the device." />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Style="{StaticResource Caption}" Text="Rate" VerticalAlignment="Center" />
                                            <ComboBox Style="{StaticResource LoopCombo}" Width="118" Height="32" Margin="8,0,0,0"
                                                      ItemsSource="{Binding SampleRates}"
                                                      SelectedItem="{Binding SelectedSampleRate}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat={}{0} Hz}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <TextBlock Style="{StaticResource Caption}" Text="Bit depth" VerticalAlignment="Center"
                                                       Margin="16,0,0,0" />
                                            <ComboBox Style="{StaticResource LoopCombo}" Width="100" Height="32" Margin="8,0,0,0"
                                                      ItemsSource="{Binding BitDepths}"
                                                      SelectedItem="{Binding SelectedBitDepth}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat={}{0} bit}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <Button Style="{StaticResource GhostButton}" Height="32" Margin="16,0,0,0"
                                                    Command="{Binding ApplyFormatCommand}" Content="Apply" />
                                            <Button Style="{StaticResource GhostButton}" Height="32" Margin="6,0,0,0"
                                                    Command="{Binding ResetFormatCommand}" Content="Reset" />
                                            <Button Style="{StaticResource GhostButton}" Height="32" Margin="6,0,0,0"
                                                    Command="{Binding OpenWindowsSettingsCommand}" Content="Windows settings" />
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Text="{Binding Message}"
                                                   Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
