<Window x:Class="LoopIt7.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:LoopIt7.Views"
        xmlns:vm="clr-namespace:LoopIt7.ViewModels"
        Title="LoopIt7"
        Width="1180" Height="760"
        MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStyle="None">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="DeviceMenuRow">
            <StackPanel>
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0"
                           Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ApplicationMenuRow">
            <StackPanel>
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0"
                           Text="{Binding Subtitle}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!--
        The root paints a near opaque surface so the Mica backdrop underneath tints the window
        without ever putting text on a translucent ground.
    -->
    <Border x:Name="Root" Background="#EB100F0D">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Canvas Width="20" Height="20" VerticalAlignment="Center">
                        <Path Data="{StaticResource MarkStrokes}"
                              Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Path Data="{StaticResource MarkDots}" Fill="{StaticResource AccentBrush}" />
                    </Canvas>
                    <TextBlock Text="LoopIt7" FontFamily="{StaticResource DisplayFont}"
                               FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimiseClick" ToolTip="Minimise" AutomationProperties.Name="Minimise">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="10" Text="&#xE921;"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="MaximiseButton" Style="{StaticResource CaptionButton}" Click="OnMaximiseClick" ToolTip="Maximise" AutomationProperties.Name="Maximise">
                        <TextBlock x:Name="MaximiseGlyph" Style="{StaticResource Glyph}" FontSize="10" Text="&#xE922;"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="OnCloseClick" ToolTip="Close" AutomationProperties.Name="Close">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="10" Text="&#xE8BB;"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Workspace switch and the actions that belong to it -->
            <Grid Grid.Row="1" Margin="18,0,18,14">
                <Border Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource ControlRadius}"
                        HorizontalAlignment="Left" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource TabToggle}" Content="Patchbay"
                                     IsChecked="{Binding IsPatchbayTab, Mode=OneWay}"
                                     Command="{Binding SelectTabCommand}">
                            <RadioButton.CommandParameter>
                                <vm:WorkspaceTab>Patchbay</vm:WorkspaceTab>
                            </RadioButton.CommandParameter>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TabToggle}" Content="Devices"
                                     IsChecked="{Binding IsDevicesTab, Mode=OneWay}"
                                     Command="{Binding SelectTabCommand}">
                            <RadioButton.CommandParameter>
                                <vm:WorkspaceTab>Devices</vm:WorkspaceTab>
                            </RadioButton.CommandParameter>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TabToggle}" Content="MIDI"
                                     IsChecked="{Binding IsMidiTab, Mode=OneWay}"
                                     Command="{Binding SelectTabCommand}">
                            <RadioButton.CommandParameter>
                                <vm:WorkspaceTab>Midi</vm:WorkspaceTab>
                            </RadioButton.CommandParameter>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding IsPatchbayTab, Converter={StaticResource BoolToVisibility}}">
                    <Button x:Name="AddSourceButton" Style="{StaticResource GhostButton}" Click="OnAddSourceClick" AutomationProperties.Name="Add source"
                            ToolTip="A microphone, a playback device tapped in loopback, or a single program">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="&#xE710;"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Add source" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AddOutputButton" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                            Click="OnAddOutputClick" AutomationProperties.Name="Add output"
                            ToolTip="Speakers, headphones, an interface, or a virtual cable">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="&#xE710;"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Add output" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButtonDanger}" Margin="6,0,0,0"
                            Command="{Binding ClearPatchbayCommand}" ToolTip="Clear the patchbay" AutomationProperties.Name="Clear the patchbay">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE74D;"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding IsDevicesTab, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshDevicesCommand}"
                            Content="Refresh" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding IsMidiTab, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding Midi.RefreshCommand}"
                            Content="Refresh" />
                </StackPanel>
            </Grid>

            <!-- Workspace -->
            <Grid Grid.Row="2">
                <views:PatchbayView Visibility="{Binding IsPatchbayTab, Converter={StaticResource BoolToVisibility}}" />
                <views:DevicesView Visibility="{Binding IsDevicesTab, Converter={StaticResource BoolToVisibility}}" />
                <views:MidiView Visibility="{Binding IsMidiTab, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Transport -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    Margin="0,14,0,0" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding ToggleRoutingCommand}"
                            AutomationProperties.Name="{Binding RoutingButtonText}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PillButton}">
                                <Style.Triggers>
                                    <!-- Running is the calm state, so the accent hands itself back to the meters. -->
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Template" Value="{StaticResource PillTemplateQuiet}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Text" Value="&#xE768;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Text" Value="&#xE71A;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding RoutingButtonText}" Margin="9,0,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Grid Grid.Column="1" Margin="18,0">
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Text="{Binding StatusText}"
                                   Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Text="{Binding Notice}"
                                   Foreground="{StaticResource AccentBrush}"
                                   Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Only present while something is soloed, which is the only time it means anything. -->
                        <Button Style="{StaticResource GhostButton}" Height="32" Margin="0,0,12,0"
                                Command="{Binding ClearSoloCommand}"
                                Visibility="{Binding IsSoloing, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Bring every source back">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="S" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Clear solo" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="Buffer" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox Style="{StaticResource LoopCombo}" Width="92" Height="32"
                                  ItemsSource="{Binding LatencyOptions}"
                                  SelectedItem="{Binding LatencyMs}"
                                  ToolTip="WASAPI buffer per endpoint. Smaller is tighter, larger is safer on a busy machine.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat={}{0} ms}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button x:Name="PresetsButton" Style="{StaticResource IconButton}" Margin="8,0,0,0"
                                Click="OnPresetsClick" ToolTip="Presets" AutomationProperties.Name="Presets">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>

                        <Button x:Name="OptionsButton" Style="{StaticResource IconButton}" Margin="2,0,0,0"
                                Click="OnOptionsClick" ToolTip="Options" AutomationProperties.Name="Options">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Add source flyout -->
            <Popup x:Name="AddSourcePopup" PlacementTarget="{Binding ElementName=AddSourceButton}"
                   Placement="Bottom" HorizontalOffset="-12" VerticalOffset="6"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{StaticResource SurfaceHiBrush}" BorderBrush="{StaticResource LineStrongBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource SurfaceRadius}"
                        Width="352" Padding="8" Margin="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.55" />
                    </Border.Effect>
                    <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Inputs" Style="{StaticResource Caption}" Margin="10,6,0,4" />
                            <ItemsControl ItemsSource="{Binding CaptureDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MenuRowButton}"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource DeviceMenuRow}"
                                                Click="OnMenuRowClick"
                                                Tag="source" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="System audio" Style="{StaticResource Caption}" Margin="10,12,0,4" />
                            <ItemsControl ItemsSource="{Binding LoopbackDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MenuRowButton}"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource DeviceMenuRow}"
                                                Click="OnMenuRowClick"
                                                Tag="source" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Applications" Style="{StaticResource Caption}" Margin="10,12,0,4" />
                            <ItemsControl ItemsSource="{Binding Applications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MenuRowButton}"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource ApplicationMenuRow}"
                                                Click="OnMenuRowClick"
                                                Tag="source" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource Caption}" Margin="10,4,10,8" TextWrapping="Wrap"
                                       Text="Only programs Windows currently lists as playing appear here. Start playback first, then reopen this menu." />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- Add output flyout -->
            <Popup x:Name="AddOutputPopup" PlacementTarget="{Binding ElementName=AddOutputButton}"
                   Placement="Bottom" HorizontalOffset="-12" VerticalOffset="6"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{StaticResource SurfaceHiBrush}" BorderBrush="{StaticResource LineStrongBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource SurfaceRadius}"
                        Width="352" Padding="8" Margin="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.55" />
                    </Border.Effect>
                    <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding OutputDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MenuRowButton}"
                                            Content="{Binding}"
                                            ContentTemplate="{StaticResource DeviceMenuRow}"
                                            Click="OnMenuRowClick"
                                            Tag="destination" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- Presets flyout -->
            <Popup x:Name="PresetsPopup" PlacementTarget="{Binding ElementName=PresetsButton}"
                   Placement="Top" HorizontalOffset="-280" VerticalOffset="0"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{StaticResource SurfaceHiBrush}" BorderBrush="{StaticResource LineStrongBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource SurfaceRadius}"
                        Width="300" Padding="14" Margin="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.55" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Presets" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource GhostButton}"
                                                HorizontalContentAlignment="Left"
                                                Command="{Binding DataContext.LoadPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource IconButtonDanger}" Margin="4,0,0,0"
                                                Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Delete this preset">
                                            <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="&#xE711;"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Caption}" Text="Nothing saved yet."
                                   Margin="2,2,0,4"
                                   Visibility="{Binding HasPresets, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,10" />

                        <TextBox Style="{StaticResource LoopTextBox}"
                                 Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Name this setup" />
                        <Button Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding SavePresetCommand}"
                                Content="Save the whole patchbay" />
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Options flyout -->
            <Popup x:Name="OptionsPopup" PlacementTarget="{Binding ElementName=OptionsButton}"
                   Placement="Top" HorizontalOffset="-300" VerticalOffset="0"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{StaticResource SurfaceHiBrush}" BorderBrush="{StaticResource LineStrongBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource SurfaceRadius}"
                        Width="320" Padding="14" Margin="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.55" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Options" Style="{StaticResource SectionLabel}" Margin="0,0,0,12" />

                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Start with Windows"
                                  IsChecked="{Binding StartWithWindows}" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Start minimised to the tray"
                                  IsChecked="{Binding StartMinimized}" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Start routing on launch"
                                  IsChecked="{Binding AutoStartRouting}" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Close button hides to the tray"
                                  IsChecked="{Binding CloseToTray}" Margin="0,0,0,12" />

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,2,0,12" />

                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Global mute hotkey"
                                  IsChecked="{Binding MuteHotkeyEnabled}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Text="{Binding HotkeyText}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="Mutes every source at once, from anywhere." />

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,12" />

                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding VersionText}" />
                                <Button Style="{StaticResource LinkButton}" Margin="0,2,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding OpenProjectCommand}"
                                        Content="{Binding AuthorText}"
                                        ToolTip="github.com/SeventhSG/LoopIt7" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource GhostButton}"
                                    Height="28" Padding="10,0"
                                    Command="{Binding OpenSettingsFolderCommand}"
                                    Content="Settings folder" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
