<UserControl x:Class="LoopIt7.Views.MidiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LoopIt7.Views">

    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="18,0,18,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Background="{StaticResource SunkenBrush}"
                Padding="16,12" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="Pick where each MIDI input should be sent. Routing here starts the moment you switch a destination on, and keeps running whether or not audio is routing." />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding Midi.HasPorts, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Midi.Inputs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,4,8" Padding="16,13">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Lamp: solid while messages are arriving, fading when they stop. -->
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{StaticResource AccentBrush}"
                                             Opacity="{Binding Activity}" />
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="-8,0,0,0"
                                             Stroke="{StaticResource LineStrongBrush}" StrokeThickness="1" />

                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Manufacturer}"
                                               Margin="10,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Caption}" Text="Send to" Margin="0,12,0,7" />

                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource Chip}"
                                                          IsChecked="{Binding IsRouted}"
                                                          Content="{Binding OutputName}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource Card}" Background="{StaticResource SunkenBrush}"
                Visibility="{Binding Midi.HasPorts, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400">
                <TextBlock Style="{StaticResource Glyph}" FontSize="20" Text="&#xE7F6;"
                           Foreground="{StaticResource TextFaintBrush}" />
                <TextBlock Text="No MIDI pair to connect"
                           FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,6,0,0"
                           Text="{Binding Midi.PortSummary}" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,6,0,0"
                           Text="Routing needs at least one of each. Plug in a keyboard or interface, or install a virtual MIDI port, then refresh." />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,10,0,0" Foreground="{StaticResource TextFaintBrush}"
                           Text="{Binding Midi.OutputSummary}" />
                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                        Command="{Binding Midi.RefreshCommand}" Content="Refresh MIDI ports" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
